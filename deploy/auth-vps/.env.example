# Домен сервера входа. Без своего домена подойдёт адрес вида
# 203-0-113-10.sslip.io — он указывает на IP 203.0.113.10.
ABOBA_AUTH_DOMAIN=
# Порт HTTPS. 443, если он свободен (адрес без порта); иначе, например, 8443.
ABOBA_HTTPS_PORT=8443

ABOBA_BOT_TOKEN=
# Длинная случайная строка, одинаковая для бота и сервера.
ABOBA_ADMIN_KEY=
ABOBA_ADMIN_IDS=
ABOBA_BOT_USERNAME=AbobaWathTV_bot
