# Скопируй как .env в корень проекта (для разработки) или в
# %APPDATA%\AbobaTV\.env (для установленного приложения).
# Файл .env в git не попадает — там могут лежать ключи.

# ── Источники фильмов (через локальный бэкенд, обычно не меняем) ──
VITE_APP_API_URL=/api-backend/ext/rhserv
VITE_KINOBD_API_URL=/api-backend/ext/kinobd
VITE_KINOBOX_API_URL=/api-backend/ext/kinobox

# Версия интерфейса
VITE_APP_VERSION=1.0.0

# Адрес сервера входа через Telegram (см. deploy/auth-vps).
# То же можно задать в приложении: «Приложение и Wi-Fi».
ABOBA_AUTH_SERVER_URL=

# Ключ kinopoiskapiunofficial.tech (запасной источник описаний).
VITE_KP_UNOFFICIAL_KEY=

# TMDB — описания и постеры, когда источник их не дал.
# Без префикса VITE_: ключ читает бэкенд, в бандл интерфейса он не попадает.
TMDB_API_KEY=
